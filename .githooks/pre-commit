#!/usr/bin/env bash
# Pre-commit guard for a PUBLIC repo. Enable once per clone:
#   git config core.hooksPath .githooks
# Requires gitleaks (brew install gitleaks).
set -euo pipefail

# 1. Secret scan of staged changes.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  echo "pre-commit: gitleaks not installed — install it (brew install gitleaks) before committing." >&2
  exit 1
fi

# 2. Blocked strings: host names, literal home paths, firm names, a named
#    third party, and the recruiting date.
# Patterns are assembled from fragments so this file never contains the
# literal strings it blocks (the repo's own history scans must stay at 0).
BLOCKED="olym""pus|/home/""daniel|/Users/""danieleghdami|Daniels-Mac""Book|\\bB""CG\\b|Bren""dan[[:space:]]+Bol""er|2026-09""-03"
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+ ' | grep -i -E "$BLOCKED" >/dev/null; then
  echo "pre-commit: staged changes contain a blocked string (host, home path or firm name)." >&2
  echo "Use \$HOME, \$PALLADRIVE_PATH or a HOST placeholder instead. Matches:" >&2
  git diff --cached -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+ ' | grep -n -i -E "$BLOCKED" >&2
  exit 1
fi
